// Discover running containers from local Docker daemon
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Relabel to capture CodePulse containers and metadata
discovery.relabel "codepulse_containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(codepulse-[a-zA-Z0-9_-]+)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?codepulse-([a-zA-Z0-9_-]+)-[0-9]+"
    target_label  = "service"
  }
}

// Scrape container logs
loki.source.docker "codepulse" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.codepulse_containers.output
  forward_to = [loki.process.codepulse.receiver]
}

// Parse structured JSON logs from codepulse
loki.process "codepulse" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {
      level           = "level",
      service         = "service",
      trace_id        = "trace_id",
      span_id         = "span_id",
      analysis_run_id = "analysis_run_id",
      repository      = "repository",
      pr_number       = "pr_number",
      task_name       = "task_name",
    }
  }

  stage.labels {
    values = {
      level    = "level",
      service  = "service",
      trace_id = "trace_id",
    }
  }
}

// Send logs to Loki
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
