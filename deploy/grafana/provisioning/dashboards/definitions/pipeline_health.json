  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "title": "PR Throughput (Webhooks / sec)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(codepulse_webhooks_received_total{status=\"accepted\"}[5m]))",
          "legendFormat": "Accepted PRs/s",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "title": "Pipeline Latency (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(codepulse_end_to_end_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Latency (s)",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(codepulse_end_to_end_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency (s)",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "codepulse_analysis_latency_p99",
          "legendFormat": "p99 Latency (Recording Rule)",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "title": "Queue Depth by Queue",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "celery_queue_depth",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "title": "Pipeline Error Rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(codepulse_webhooks_received_total{status=\"error\"}[5m])) / (sum(rate(codepulse_webhooks_received_total[5m])) > 0 or 1)",
          "legendFormat": "Error Rate Ratio",
          "refId": "A"
        }
      ]
    }
  ],
