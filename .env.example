# CodePulse AI — Environment Variables Template
# Copy this file to .env and configure your secrets.

# Database and Broker Connections
DATABASE_URL=postgresql://codepulse:codepulse_dev@postgres:5432/codepulse
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# GitHub App Credentials
GITHUB_WEBHOOK_SECRET=dev_webhook_secret_not_for_production
ADMIN_API_KEY=dev_admin_key_not_for_production

# Grafana Security (REQUIRED: set a secure admin password, no default permitted)
GRAFANA_ADMIN_PASSWORD=

# Gemini API & Rate Limits
GEMINI_API_KEY=
GEMINI_RPM_LIMIT=324
GEMINI_RATE_LIMIT_DEADLINE=60.0

# Mock Flags for Local Development / Testing
MOCK_GITHUB=true
MOCK_LLM=true
MOCK_LLM_FAILURE=false
MOCK_RATE_LIMIT=false
MOCK_RATE_LIMIT_WAIT=2.0
MOCK_GITHUB_RATE_LIMIT=false
MOCK_GITHUB_RESET_TS=0
MOCK_POSTING_FAILURE=false
MOCK_QUICK_RETRIES=false
